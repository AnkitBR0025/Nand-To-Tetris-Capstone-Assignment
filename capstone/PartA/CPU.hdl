// CPU for the Hack computer. Uses the standard built-in ALU,
// ARegister, DRegister and PC chips supplied by the Nand2Tetris simulator.
CHIP CPU {
    IN inM[16], instruction[16], reset;
    OUT outM[16], writeM, addressM[15], pc[15];

    PARTS:
    // A instruction loads its 15-bit value into A.
    // C instruction may also load A when destination bit a is set.
    Not(in=instruction[15], out=isAInstruction);
    And(a=instruction[15], b=instruction[5], out=cLoadA);
    Or(a=isAInstruction, b=cLoadA, out=loadA);
    Mux16(a=instruction, b=aluOut, sel=instruction[15], out=aInput);
    ARegister(in=aInput, load=loadA, out=aReg, out[0..14]=addressM);

    // D destination bit.
    And(a=instruction[15], b=instruction[4], out=loadD);
    DRegister(in=aluOut, load=loadD, out=dReg);

    // ALU y input is A or M according to the a-bit of comp.
    Mux16(a=aReg, b=inM, sel=instruction[12], out=yInput);
    ALU(x=dReg, y=yInput,
        zx=instruction[11], nx=instruction[10],
        zy=instruction[9], ny=instruction[8],
        f=instruction[7], no=instruction[6],
        out=aluOut, out=outM, zr=zr, ng=ng);

    // Memory write is enabled only by a C-instruction with dest M.
    And(a=instruction[15], b=instruction[3], out=writeM);

    // Decode the three jump bits for the ALU result.
    And(a=instruction[2], b=ng, out=jumpLT);
    And(a=instruction[1], b=zr, out=jumpEQ);
    Or(a=ng, b=zr, out=notPositive);
    Not(in=notPositive, out=positive);
    And(a=instruction[0], b=positive, out=jumpGT);
    Or(a=jumpLT, b=jumpEQ, out=jumpLE);
    Or(a=jumpLE, b=jumpGT, out=anyJump);
    And(a=instruction[15], b=anyJump, out=loadPC);

    PC(in=aReg, load=loadPC, inc=true, reset=reset, out[0..14]=pc);
}
