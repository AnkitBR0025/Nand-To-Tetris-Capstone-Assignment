CHIP Memory {
    IN in[16], load, address[15];
    OUT out[16];

    PARTS:
    Not(in=address[14], out=loadRAMSelect);
    And(a=load, b=loadRAMSelect, out=loadRAM);
    RAM16K(in=in, load=loadRAM, address=address[0..13], out=ramOut);

    Not(in=address[13], out=notAddress13);
    And(a=address[14], b=notAddress13, out=screenSelect);
    And(a=load, b=screenSelect, out=loadScreen);
    Screen(in=in, load=loadScreen, address=address[0..12], out=screenOut);

    Keyboard(out=keyOut);
    Mux16(a=screenOut, b=keyOut, sel=address[13], out=ioOut);
    Mux16(a=ramOut, b=ioOut, sel=address[14], out=out);
}
